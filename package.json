{
  "name": "getalive-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Tema WordPress do GetAlive: layouts de live para o OBS Studio",
  "scripts": {
    "dev": "parcel watch src/js/main.js src/css/login.css --dist-dir dist --public-url ./ --no-hmr",
    "build": "rimraf dist .parcel-cache && parcel build src/js/main.js src/css/login.css --dist-dir dist --public-url ./ --no-source-maps",
    "clean": "rimraf dist .parcel-cache"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "parcel": "^2.16.4",
    "postcss": "^8.5.32",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@swup/a11y-plugin": "^5.2.1",
    "@swup/body-class-plugin": "^3.3.0",
    "@swup/head-plugin": "^2.3.1",
    "@swup/preload-plugin": "^3.2.12",
    "@swup/scroll-plugin": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swup": "^4.10.0"
  }
}
